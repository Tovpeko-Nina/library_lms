# Скопируйте файл в .env. Не используйте эти значения в production.
SECRET_KEY=generate-a-long-random-value
DATABASE_URL=postgresql://lms:lms-local-password@127.0.0.1:5432/lms

# Используются Docker Compose для создания БД и строки подключения контейнера.
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms-local-password

# Если значение не задано, встроенный администратор не создаётся.
INITIAL_ADMIN_PASSWORD=set-a-local-password

# Отключите демонстрационный каталог в production.
SEED_DEMO_DATA=true
